```javascript
/* =========================================
   LOAD SELECT BARANG
   Mengisi dropdown barang otomatis
========================================= */

async function loadSelectBarang(){

  const { data } =
  await supabaseClient

  .from("barang")

  .select("*")

  .order(
    "nama",
    {
      ascending:true
    }
  );

  let option =
  `<option value="">Pilih Barang</option>`;

  data.forEach(item=>{

    option += `

      <option value="${item.id}">

        ${item.nama}
        (${item.stok})

      </option>

    `;

  });

  document
  .getElementById(
    "masukBarang"
  )
  .innerHTML =
  option;

  document
  .getElementById(
    "keluarBarang"
  )
  .innerHTML =
  option;

}

/* =========================================
   FORM BARANG MASUK
========================================= */

document
.getElementById(
  "formMasuk"
)
.addEventListener(
"submit",
async(e)=>{

  e.preventDefault();

  const barangId =
  parseInt(
    document
    .getElementById(
      "masukBarang"
    ).value
  );

  const qty =
  parseInt(
    document
    .getElementById(
      "masukQty"
    ).value
  );

  const ket =
  document
  .getElementById(
    "masukKeterangan"
  ).value;

  if(!barangId || !qty){

    showToast(
      "Lengkapi data"
    );

    return;

  }

  await simpanBarangMasuk(
    barangId,
    qty,
    ket
  );

});

/* =========================================
   SIMPAN BARANG MASUK
========================================= */

async function simpanBarangMasuk(
  barangId,
  qty,
  keterangan
){

  const {

    data:barang

  } = await supabaseClient

  .from("barang")

  .select("*")

  .eq(
    "id",
    barangId
  )

  .single();

  const { error } =
  await supabaseClient

  .from("barang_masuk")

  .insert([{

    barang_id:
    barangId,

    qty,

    keterangan

  }]);

  if(error){

    showToast(
      error.message
    );

    return;

  }

  await supabaseClient

  .from("barang")

  .update({

    stok:
    barang.stok + qty

  })

  .eq(
    "id",
    barangId
  );

  await saveActivity(

    `Barang masuk:
     ${barang.nama}
     (+${qty})`

  );

  showToast(
    "Barang masuk berhasil"
  );

  document
  .getElementById(
    "formMasuk"
  )
  .reset();

  await loadBarang();

  await loadDashboard();

  await loadBarangMasuk();

  await loadSelectBarang();

}

/* =========================================
   LOAD BARANG MASUK
========================================= */

async function loadBarangMasuk(){

  const {

    data

  } = await supabaseClient

  .from("barang_masuk")

  .select(`
    *,
    barang(
      nama
    )
  `)

  .order(
    "id",
    {
      ascending:false
    }
  );

  let html = "";

  data.forEach(item=>{

    html += `

    <tr>

      <td>
        ${new Date(
          item.created_at
        ).toLocaleString()}
      </td>

      <td>
        ${item.barang?.nama || '-'}
      </td>

      <td>
        ${item.qty}
      </td>

      <td>
        ${item.keterangan || '-'}
      </td>

    </tr>

    `;

  });

  document
  .getElementById(
    "barangMasukTable"
  )
  .innerHTML =
  html;

}

/* =========================================
   FORM BARANG KELUAR
========================================= */

document
.getElementById(
  "formKeluar"
)
.addEventListener(
"submit",
async(e)=>{

  e.preventDefault();

  const barangId =
  parseInt(
    document
    .getElementById(
      "keluarBarang"
    ).value
  );

  const qty =
  parseInt(
    document
    .getElementById(
      "keluarQty"
    ).value
  );

  const tujuan =
  document
  .getElementById(
    "keluarTujuan"
  ).value;

  if(!barangId || !qty){

    showToast(
      "Lengkapi data"
    );

    return;

  }

  await simpanBarangKeluar(
    barangId,
    qty,
    tujuan
  );

});

/* =========================================
   SIMPAN BARANG KELUAR
========================================= */

async function simpanBarangKeluar(
  barangId,
  qty,
  tujuan
){

  const {

    data:barang

  } = await supabaseClient

  .from("barang")

  .select("*")

  .eq(
    "id",
    barangId
  )

  .single();

  if(barang.stok < qty){

    showToast(
      "Stok tidak cukup"
    );

    return;

  }

  const { error } =
  await supabaseClient

  .from("barang_keluar")

  .insert([{

    barang_id:
    barangId,

    qty,

    tujuan

  }]);

  if(error){

    showToast(
      error.message
    );

    return;

  }

  await supabaseClient

  .from("barang")

  .update({

    stok:
    barang.stok - qty

  })

  .eq(
    "id",
    barangId
  );

  await saveActivity(

    `Barang keluar:
     ${barang.nama}
     (-${qty})`

  );

  showToast(
    "Barang keluar berhasil"
  );

  document
  .getElementById(
    "formKeluar"
  )
  .reset();

  await loadBarang();

  await loadDashboard();

  await loadBarangKeluar();

  await loadSelectBarang();

}

/* =========================================
   LOAD BARANG KELUAR
========================================= */

async function loadBarangKeluar(){

  const {

    data

  } = await supabaseClient

  .from("barang_keluar")

  .select(`
    *,
    barang(
      nama
    )
  `)

  .order(
    "id",
    {
      ascending:false
    }
  );

  let html = "";

  data.forEach(item=>{

    html += `

    <tr>

      <td>
        ${new Date(
          item.created_at
        ).toLocaleString()}
      </td>

      <td>
        ${item.barang?.nama || '-'}
      </td>

      <td>
        ${item.qty}
      </td>

      <td>
        ${item.tujuan || '-'}
      </td>

    </tr>

    `;

  });

  document
  .getElementById(
    "barangKeluarTable"
  )
  .innerHTML =
  html;

}
```
